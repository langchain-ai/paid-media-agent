# Runtime: model (`provider:model`; the LangSmith Gateway form is langsmith:provider/model), limits, paths.
PAID_MEDIA_MODEL=anthropic:claude-sonnet-4-6
# PAID_MEDIA_MODEL=langsmith:anthropic/claude-sonnet-4-6
PAID_MEDIA_MODEL_BASE_URL=
PAID_MEDIA_TOOL_SELECTOR_MODEL=
# Name of the env var holding the model key when the provider has no default (e.g. MOONSHOT_API_KEY),
# or LANGSMITH_GATEWAY_API_KEY when the gateway key differs from LANGSMITH_API_KEY.
PAID_MEDIA_MODEL_API_KEY_ENV=
PAID_MEDIA_MODEL_TIMEOUT_SECONDS=120
PAID_MEDIA_MAX_MODEL_CALLS=40
# Preferred hosting path: local, mda (paid managed hosting), or self_hosted.
PAID_MEDIA_RUNTIME=local
# sample always uses synthetic accounts, even with live credentials saved.
# live requires a connected provider. auto preserves credential-based CLI selection.
PAID_MEDIA_DATA_MODE=auto
PAID_MEDIA_LOG_LEVEL=INFO

# Model providers. Set only the one you use. Optional providers need their extra installed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OpenAI-compatible endpoints (set PAID_MEDIA_MODEL_BASE_URL and PAID_MEDIA_MODEL_API_KEY_ENV):
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=

# LangSmith: LANGSMITH_API_KEY (below) serves tracing, the gateway, sandboxes, and mda deploy.
# Use a second key here only when the gateway key differs.
LANGSMITH_GATEWAY_API_KEY=

# Direct X/OpenAI Ads credentials. LinkedIn uses Pipeboard when its token is set;
# existing direct LinkedIn credentials still work for standalone CLI setups.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
OPENAI_ADS_API_KEY=

# Pipeboard. Create a scoped token at https://pipeboard.co/api-tokens.
PIPEBOARD_API_TOKEN=
PIPEBOARD_GOOGLE_ADS_MCP_URL=https://google-ads.mcp.pipeboard.co/
PIPEBOARD_META_ADS_MCP_URL=https://meta-ads.mcp.pipeboard.co/
PIPEBOARD_REDDIT_ADS_MCP_URL=https://reddit-ads.mcp.pipeboard.co/
PIPEBOARD_TIKTOK_ADS_MCP_URL=https://tiktok-ads.mcp.pipeboard.co/
PIPEBOARD_PINTEREST_ADS_MCP_URL=https://pinterest-ads.mcp.pipeboard.co/
PIPEBOARD_SNAP_ADS_MCP_URL=https://snap-ads.mcp.pipeboard.co/
PIPEBOARD_GOOGLE_ANALYTICS_MCP_URL=https://google-analytics.mcp.pipeboard.co/
PIPEBOARD_LINKEDIN_ADS_MCP_URL=https://linkedin-ads.mcp.pipeboard.co/

# Account aliases map human-readable local names to host-owned provider ids.
# Never let the model supply an arbitrary account id for execution.
PAID_MEDIA_ACCOUNT_CONFIG_PATH=config/accounts.example.toml

# Writes default off. Enabling this flag does not bypass approval, and live provider mutations
# stay unreleased until the Slice 6 canary is separately authorized.
PAID_MEDIA_WRITES_ENABLED=false
PAID_MEDIA_APPROVER_IDS=
PAID_MEDIA_APPROVAL_SIGNING_KEY=
PAID_MEDIA_APPROVAL_TTL_SECONDS=900
PAID_MEDIA_ALLOW_SELF_APPROVAL=false
# Approver refs are the identities the platform presents when someone clicks Approve. A refused
# approval names the ref it saw; paste that here. Local runs use `local-user`.

# Reviewed mutation set (data). Live canary gates; see docs/operations/live-write-runbook.md.
PAID_MEDIA_WRITE_POLICY_PATH=config/write-policy.example.toml
PAID_MEDIA_KILL_SWITCH_PATH=workspace/KILL_SWITCH
PAID_MEDIA_LIVE_WRITE_CATALOG_REVISION=
PAID_MEDIA_LIVE_WRITE_CANARY_TOOLS=

# Self-hosted path only. The rich Slack adapter: create the app from config/slack-manifest.example.yaml.
# Socket Mode (bot token + app-level token) needs no public URL; the HTTP transport needs the signing secret.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRANSPORT=socket_mode

# Self-hosted path only. Postgres for proposals, approvals, receipts, and checkpoints (docker compose
# sets it); API bearer tokens as `token:caller` pairs; bind address for `paid-media-agent serve`.
DATABASE_URL=
PAID_MEDIA_API_TOKENS=
PAID_MEDIA_API_HOST=127.0.0.1
PAID_MEDIA_API_PORT=8080

# The sandbox Managed Deep Agents gives every thread. Optional: `paid-media-agent sandbox publish`
# builds sandbox/Dockerfile on LangSmith (PDF rendering, pinned toolchain) and declares the
# snapshot here and in sandbox/__init__.py. Empty means MDA's default image.
PAID_MEDIA_SANDBOX_SNAPSHOT=

# LangSmith key for mda dev, mda deploy, and sandbox snapshots (and the gateway, unless a
# separate LANGSMITH_GATEWAY_API_KEY is set above).
LANGSMITH_API_KEY=

# Tuning (rarely changed).
PAID_MEDIA_WORKSPACE_ROOT=workspace
# Synthetic data ends two days ago by default; pin a date only to reproduce a window.
PAID_MEDIA_FIXTURE_ANCHOR=
PAID_MEDIA_MAX_SELECTED_TOOLS=6
PAID_MEDIA_RESULT_OFFLOAD_CHARS=6000
PAID_MEDIA_SANDBOX_IDLE_TTL_SECONDS=1800
